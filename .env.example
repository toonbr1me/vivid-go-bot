# Обязательные подключения -------------------------------------------------
BOT_TOKEN=123456:telegram-bot-token
# Отдельный бот для обращений. Он запускается, только когда включён флаг.
# Не указывать эти значения в app_settings или в Git.
SUPPORT_BOT_TOKEN=
SUPPORT_BOT_USERNAME=
SUPPORT_BOT_ENABLED=false
DATABASE_URL=postgres://vivid:vivid@localhost:5432/vivid?sslmode=disable

# Remnawave: панель, в которой живут подписки.
API_BASE_URL=https://panel.example.com
API_TOKEN=panel-api-token
# Для отдельного dev-стенда на общей панели. Пусто — обычная работа.
# Префикс имён и отдельный диапазон Telegram ID изолируют тестовые профили.
# Эти две настройки читаются только из окружения, не из app_settings.
REMNAWAVE_NAMESPACE=
SUBSCRIPTION_BASE_URL=

# Доступ --------------------------------------------------------------------
# Через запятую. Владелец — первый в списке, остальные получают роли в /admin.
ADMIN_IDS=100000001

# Дни по умолчанию для заказа без явного тарифа.
DEFAULT_EXPIRE_DAYS=30
# Пусто — без ограничения трафика. Понимает суффиксы: 100GB, 512MB.
TRAFFIC_LIMIT_BYTES=
EXTERNAL_SQUAD_UUID=
EXTERNAL_SQUAD_NAME=
INTERNAL_SQUAD_UUIDS=
REQUEST_TIMEOUT=10
CURRENCY=RUB

# Бренд и контакты ----------------------------------------------------------
BRAND_NAME=Vivid
LEGAL_ENTITY=
SUPPORT_EMAIL=support@example.com
SUPPORT_USERNAME=
PRIVACY_POLICY_URL=
TERMS_URL=
CONNECT_GUIDE_URL=
# JSON-объект: {"main": "https://.../photo.jpg"}
PHOTO_URLS={}
EXCHANGE_RATE_NOTE=

# Сайт ----------------------------------------------------------------------
SITE_ENABLED=true
WEBAPP_ENABLED=true
PREVIEW_ENABLED=true
# Богатые сообщения Telegram: таблицы, заголовки и кнопки внутри текста.
# false — бот отправляет обычный HTML (полезно для старого Bot API).
RICH_MESSAGES_ENABLED=true
# Основной поддерживаемый интерфейс — legacy (rich с обычным HTML fallback).
# html — экспериментальные widget-карточки; нужен сервер Telegram с их поддержкой.
BOT_STYLE=legacy
BOT_HTML_TEMPLATE=default
# telegram — цвета клиента; custom — bot-theme.json + CSS шаблона.
BOT_HTML_THEME=telegram
# Удалять обработанные команды и сохранённые сообщения поддержки.
BOT_CLEAN_CHAT=true
# Включать после подключения автоплатежей у соответствующего провайдера.
PAYMENTS_RECURRING_ENABLED=false
# Для Platega нужен согласованный период списаний в днях (1–730).
PAYMENTS_RECURRING_PROVIDERS=yookassa,platega
PUBLIC_BASE_URL=https://vivid.example.com
# По умолчанию совпадает с PUBLIC_BASE_URL.
SITE_BASE_URL=
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
# Необязательно: без него ссылки-приглашения строятся без username.
BOT_USERNAME=

# Вход через Google (необязательно; вход по коду из бота работает всегда).
# Redirect URI: https://vivid.example.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Платежи -------------------------------------------------------------------
# Порядок важен: первый шлюз — приоритетный. Пусто — платежи выключены.
PAYMENT_PROVIDERS=yookassa
# Через запятую: card, sbp, tpay, sberpay.
PAYMENT_METHODS=card,sbp
PAYMENT_LINK_EXPIRATION_MINUTES=4320
MIN_PAYMENT_AMOUNT=10

WATA_ACCESS_TOKEN=
WATA_ACCESS_TOKEN_CARD=
WATA_ACCESS_TOKEN_SBP=
WATA_API_BASE_URL=https://api.wata.pro/api/h2h
WATA_PUBLIC_KEY_URL=https://api.wata.pro/api/h2h/public-key

PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_API_BASE_URL=https://app.platega.io

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3

# Telegram Stars: только для бота, вебхук не нужен.
TELEGRAM_STARS_ENABLED=false
TELEGRAM_STARS_PRICE=1.5

# Пробные периоды -----------------------------------------------------------
TRIAL_WEB_DAYS=1
TRIAL_BOT_DAYS=7
TRIAL_WEB_INTERNAL_SQUAD_UUIDS=
TRIAL_BOT_INTERNAL_SQUAD_UUIDS=
TRIAL_TRAFFIC_LIMIT_BYTES=
TRIAL_RESET_TRAFFIC_ON_PAID=true

# Устройства ----------------------------------------------------------------
DEVICE_LIMIT_ENABLED=true
DEVICE_LIMIT_BASE=5

# Промокоды, рефералы, поддержка -------------------------------------------
REFERRAL_MODE=days
REFERRAL_BALANCE_PERCENT=10
PROMO_MAX_CODES_PER_USER=3
SUPPORT_COMPENSATION_DAILY_DAYS=14
# Необязательный подписанный webhook панели: POST /webhooks/remnawave.
# Тот же секрет, что WEBHOOK_SECRET_HEADER панели. Оставить пустым для отключения.
REMNAWAVE_WEBHOOK_SECRET=
REMIND_UNPAID_INVOICE_HOURS=0
REMIND_NOT_CONNECTED_HOURS=0

# Помощник поддержки ------------------------------------------------------
# Отвечает на типовые вопросы сам, остальное уходит сотруднику.
# Говорящий API один: OpenAI-совместимый /v1/chat/completions.
#   Ollama:  SUPPORT_LLM_URL=http://127.0.0.1:11434
#   OpenAI:  SUPPORT_LLM_URL=https://api.openai.com/v1
SUPPORT_LLM_ENABLED=false
SUPPORT_LLM_PROVIDER=ollama
SUPPORT_LLM_URL=http://127.0.0.1:11434
SUPPORT_LLM_MODEL=
SUPPORT_LLM_API_KEY=
SUPPORT_LLM_TIMEOUT=30
# Сколько ответов помощник даёт на одно обращение.
SUPPORT_LLM_MAX_REPLIES=2
# Процент обращений, на которые отвечает помощник (остальные — сотрудник).
SUPPORT_LLM_SHARE=100

# Шаблоны и тема ------------------------------------------------------------
# Папка с необязательными переопределениями: templates/, static/, theme.json.
WEB_DIR=web

# Логи: debug, info, warn, error.
LOG_LEVEL=info

# Prometheus: /metrics requires Authorization: Bearer <token>. Empty disables it.
METRICS_TOKEN=
